# Add to the LOCAL root .env. Use a read-only IAM user for the production bucket
# (management/development-s3-read-policy.json). Do not put R2 write secrets here.
APP_ENV=development
DEBUG=True
URL_BASE=https://localhost
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional; normally leave unset. Defaults to backend/media/development.
# DEVELOPMENT_FILE_ROOT=/backend/media/development
# Optional WAL prune window for the local archive. Default 14 days.
# WAL_RETENTION_DAYS=14
# Production uses APP_ENV=production, DEBUG=False and the real website URL.
