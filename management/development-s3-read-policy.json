{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProductionBackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::landar"
    },
    {
      "Sid": "ReadProductionBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::landar/*"
    }
  ]
}
